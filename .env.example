# --- Required ---
MOTHER_BOT_TOKEN=123456789:AAE-your-mother-bot-token
# your numeric Telegram ID — unlocks the /admin owner panel
ADMIN_ID=123456789
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
PRIVATE_CHANNEL_ID=-1001234567890

# --- Payments ---
CARD_NUMBER=0000-0000-0000-0000
CARD_HOLDER=نام صاحب کارت
PRO_PRICE_TOMAN=99000
PRO_DURATION_DAYS=30

# --- Referral ---
REFERRAL_INVITES=3
REFERRAL_REWARD_DAYS=10

# --- Performance tuning (optional, defaults are fine) ---
# per-request AI timeout in seconds
AI_TIMEOUT=30
# seconds to wait before starting a parallel fallback model (hedging)
AI_HEDGE_DELAY=2.5
# max simultaneous AI model attempts
AI_MAX_PARALLEL=3
# drop messages that arrived while child bots were down (recommended: true)
CHILD_DROP_PENDING_UPDATES=true
