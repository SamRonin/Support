# ===== Required =====

# Token of the MOTHER bot (from @BotFather)
MOTHER_BOT_TOKEN=123456789:AAE_your_mother_bot_token_here

# Your numeric Telegram user id (admin). Get it from @userinfobot
ADMIN_ID=123456789

# Neon Postgres connection string (Project -> Dashboard -> Connection string -> pooled)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Private channel id where receipts are sent for approval (e.g. -1001234567890)
# 1) Create a private channel  2) Add your bot as admin
# 3) Post a message there, then open https://api.telegram.org/bot<MOTHER_BOT_TOKEN>/getUpdates
#    and find "chat":{"id":-100xxxxxxxxxx}
PRIVATE_CHANNEL_ID=-1000000000000

# ===== Payment info =====
CARD_NUMBER=6037-9975-1234-5678
CARD_HOLDER=نام و نام خانوادگی صاحب کارت
PRO_PRICE_TOMAN=99000
PRO_DURATION_DAYS=30

# ===== Referral program =====
REFERRAL_INVITES=3
REFERRAL_REWARD_DAYS=10
